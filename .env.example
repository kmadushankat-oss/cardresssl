# Copy to .env and fill in. See README.md for where each value comes from.

# ---------- Database ----------
# Local dev: postgresql://cardresssl:cardresssl_dev@127.0.0.1:5433/cardresssl?schema=public
# Production: the Neon *pooled* connection string.
DATABASE_URL=""

# ---------- Auth ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Email (Resend) ----------
# Empty => mail is logged to the console instead of sent.
RESEND_API_KEY=""
MAIL_FROM="Car Dress SL <no-reply@cardresssl.com>"
MAIL_REPLY_TO="info@cardresssl.com"
MAIL_NOTIFY_TO="info@cardresssl.com"

# ---------- Image storage (Vercel Blob) ----------
# Empty => uploads go to ./public/uploads (dev only; Vercel's disk is ephemeral).
BLOB_READ_WRITE_TOKEN=""

# ---------- WooCommerce migration ----------
WOO_SOURCE_URL="https://cardresssl.com"

# ---------- Seed ----------
SEED_OWNER_NAME="Admin"
SEED_OWNER_EMAIL="admin@cardresssl.com"
SEED_OWNER_PASSWORD=""
